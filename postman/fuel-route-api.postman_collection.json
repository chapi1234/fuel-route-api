  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Plan a trip",
      "item": [
        {
          "name": "Denver, CO → Chicago, IL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trip-plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "trip-plans"
              ]
            },
            "description": "About 1,000 miles: the full starting tank covers the first 500.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Denver, CO\",\n  \"finish\": \"Chicago, IL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"planId\", body.id);",
                  "pm.collectionVariables.set(\"mapUrl\", body.map_url);",
                  "pm.test(\"At most one routing call\", () => pm.expect(body.meta.external_api_calls.routing).to.be.at.most(1));",
                  "pm.test(\"Gallons bought + starting tank = trip gallons\", () => {",
                  "  const s = body.summary;",
                  "  pm.expect(s.gallons_purchased + s.starting_tank_gallons_used).to.be.closeTo(s.trip_gallons, 0.05);",
                  "});",
                  "console.log(`Fuel: $${body.summary.total_fuel_cost} over ${body.summary.number_of_stops} stops. Map: ${body.map_url}`);"
                ]
              }
            }
          ]
        },
